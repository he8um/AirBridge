# Enforce LF line endings for all text files on all platforms.
* text=auto eol=lf

# Explicitly binary files — no line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.dmg binary
*.exe binary
*.msi binary
*.AppImage binary
*.deb binary
*.airbridge binary
